{
  "name": "permalink-generator-cypress",
  "version": "1.0.0",
  "private": true,
  "description": "Cypress integration tests for the permalink-generator Jahia module",
  "scripts": {
    "e2e:ci": "cypress run",
    "e2e:debug": "cypress open",
    "lint": "eslint . -c .eslintrc.json --ext .ts",
    "lint:fix": "yarn lint --fix",
    "report:merge": "mochawesome-merge results/reports/cypress*.json > results/reports/report.json && rm results/reports/cypress*.json",
    "report:html": "marge --inline results/reports/report.json --reportDir results/reports/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jahia/permalink-generator.git",
    "directory": "tests"
  },
  "license": "MIT",
  "packageManager": "yarn@1.22.22",
  "devDependencies": {
    "@jahia/cypress": "^7.0.0",
    "@jahia/eslint-config": "^2.1.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "compare-versions": "^6.1.1",
    "cypress": "13.17.0",
    "cypress-multi-reporters": "^2.0.5",
    "cypress-terminal-report": "^7.4.0",
    "cypress-wait-until": "^3.0.1",
    "eslint": "^8.51.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-chai-friendly": "^1.2.1",
    "eslint-plugin-cypress": "^7.0.2",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-promise": "^7.3.0",
    "jahia-reporter": "^0.4.2",
    "mocha": "^10.0.0",
    "mocha-junit-reporter": "^2.2.0",
    "mochawesome": "^8.1.1",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2",
    "prettier": "^3.9.10",
    "typescript": "^4.4.4"
  },
  "dependencies": {
    "cross-fetch": "4.1.0"
  },
  "resolutions": {
    "axios": "^1.20.0",
    "baseline-browser-mapping": "^2.11.22",
    "browserslist": "^4.28.9",
    "follow-redirects": "^1.16.1",
    "qs": "^6.16.1",
    "serialize-javascript": "^7.1.3",
    "uuid": "^11.1.1"
  }
}
